# Copy to .env and fill in. Never commit the real .env.

# --- AI tutor / playground backend ---
# The client never holds a model provider key. It calls our own gateway, which
# holds the provider credential and enforces per-user rate limits & entitlements.
EXPO_PUBLIC_API_BASE_URL=https://api.synapse.app
EXPO_PUBLIC_API_TIMEOUT_MS=30000

# --- Analytics (client-safe write key) ---
EXPO_PUBLIC_ANALYTICS_KEY=

# --- In-app purchase / subscription ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Feature flags ---
EXPO_PUBLIC_ENABLE_AI_TUTOR=true
EXPO_PUBLIC_ENABLE_LEAGUES=true
