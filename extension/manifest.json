{
  "manifest_version": 3,
  "name": "FlowCompanion",
  "version": "1.0.0",
  "description": "Save pages and selections to the FlowCompanion desktop app on this computer, or ask its AI about them.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "FlowCompanion",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "notifications"],
  "host_permissions": ["http://127.0.0.1/*"]
}
