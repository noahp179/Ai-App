{
  "name": "flowcompanion",
  "productName": "FlowCompanion",
  "version": "0.1.0",
  "private": true,
  "description": "A standalone desktop workspace for AI, productivity, learning and personal organization.",
  "license": "MIT",
  "author": "FlowCompanion contributors",
  "homepage": "https://github.com/noahp179/Ai-App",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "server": "node scripts/build.mjs --only=server && node dist/server/main.js",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "verify:links": "node scripts/verify-links.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "luxon": "^3.7.2",
    "zod": "^4.6.7",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.61.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
